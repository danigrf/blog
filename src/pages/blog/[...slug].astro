---
import { type CollectionEntry, render } from 'astro:content';
import * as bausteine from '../../components/bausteine';
import BlogPost from '../../layouts/BlogPost.astro';
import { getPosts, verwandtePosts } from '../../lib/posts';

export async function getStaticPaths() {
	const posts = await getPosts();
	return posts.map((post) => ({
		params: { slug: post.id },
		props: { post, verwandte: verwandtePosts(post, posts) },
	}));
}
type Props = { post: CollectionEntry<'blog'>; verwandte: ReturnType<typeof verwandtePosts> };

const { post, verwandte } = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data} verwandte={verwandte}>
	<Content components={bausteine} />
</BlogPost>
