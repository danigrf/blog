---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import JahresUebersicht from '../../components/JahresUebersicht.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/posts';
import { SITE_DESCRIPTION } from '../../consts';

const posts = await getPosts();
const jahrMin = Math.min(...posts.map((p) => p.data.pubDate.getFullYear()));
const jahrMax = Math.max(...posts.map((p) => p.data.pubDate.getFullYear()));
const jahre = Array.from({ length: jahrMax - jahrMin + 1 }, (_, i) => {
	const jahr = jahrMin + i;
	return { jahr, werte: [posts.filter((p) => p.data.pubDate.getFullYear() === jahr).length] };
});
---

<!doctype html>
<html lang="de-CH">
	<head>
		<BaseHead title="Blog – Daniel Graf" description={SITE_DESCRIPTION} />
		<style>
			:global(h2.jahr-titel) {
				font-family: var(--mono);
				font-size: 1rem;
				font-weight: 500;
				letter-spacing: 0.04em;
				line-height: 1.3;
				color: var(--muted);
				margin: 2rem 0 0.5rem;
			}
			:global(h2.jahr-titel) { scroll-margin-top: 1rem; }
			.jahr-gruppe:first-child :global(h2.jahr-titel) { margin-top: 1rem; }
			.mehr { margin: 1.5rem 0 0.5rem; text-align: center; }
			.mehr[hidden] { display: none; }
			.mehr button {
				font: inherit;
				font-family: var(--sans);
				font-size: 1rem;
				min-height: 2.75rem;
				padding: 0.5rem 1.4rem;
				color: var(--accent-strong);
				background: transparent;
				border: 1px solid var(--accent);
				border-radius: 4px;
				cursor: pointer;
			}
			.mehr button:hover { background: var(--mark); }
			.mehr button:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
			.jahr-gruppe[hidden], .post-list li[hidden] { display: none; }
		</style>
	</head>
	<body>
		<Header />
		<main id="inhalt">
			<h1>Blog</h1>
			<p class="meta"><a href="/themen/">Themen und Beiträge durchsuchen</a></p>
			<JahresUebersicht jahre={jahre} prefix="jahr-" />
			<div id="liste"><PostList posts={posts} nachJahr /></div>
			<div class="mehr" id="f-mehr" hidden>
				<button type="button" id="f-mehr-btn">Mehr anzeigen</button>
				<div id="f-sentinel" aria-hidden="true"></div>
			</div>
		</main>
		<Footer />
		<script is:inline>
			(function () {
				var items = Array.prototype.slice.call(document.querySelectorAll('#liste li[data-jahr]'));
				var gruppen = Array.prototype.slice.call(document.querySelectorAll('#liste .jahr-gruppe'));
				var mehr = document.getElementById('f-mehr');
				var mehrBtn = document.getElementById('f-mehr-btn');
				var sentinel = document.getElementById('f-sentinel');
				var mq = window.matchMedia('(max-width: 560px)');
				var limit = 0;
				var paket = function () { return mq.matches ? 10 : 20; };

				// Filter-Schnittstelle: window.blogFilter = { thema: 'slug', von: 2010, bis: 2020 } setzen und
				// danach das Ereignis «blog:filter» auslösen. Leere Werte = kein Filter.
				var filter = window.blogFilter = window.blogFilter || { thema: '', von: '', bis: '' };
				function themaOk(li) {
					return !filter.thema || (' ' + li.getAttribute('data-themen') + ' ').indexOf(' ' + filter.thema + ' ') > -1;
				}
				function jahrOk(jahr) {
					return (!filter.von || jahr >= Number(filter.von)) && (!filter.bis || jahr <= Number(filter.bis));
				}
				function passt(li) { return themaOk(li) && jahrOk(Number(li.getAttribute('data-jahr'))); }
				var uebersicht = document.querySelector('.ju');

				// Balken: alle Treffer je Jahr (nicht nur die geladenen); Jahre ausserhalb Von-Bis abgeschwächt.
				function balken() {
					if (!uebersicht || !uebersicht.juUpdate) return;
					var werte = {}, aus = {};
					items.forEach(function (li) {
						if (!themaOk(li)) return;
						var j = li.getAttribute('data-jahr');
						werte[j] = werte[j] || [0];
						werte[j][0]++;
						if (!jahrOk(Number(j))) aus[j] = true;
					});
					uebersicht.juUpdate(werte, aus);
				}

				function zeichnen(fokusAb) {
					var gezeigt = 0, ersterNeu = null;
					items.forEach(function (li) {
						var an = passt(li) && gezeigt < limit;
						if (an && li.hidden && fokusAb !== undefined && gezeigt >= fokusAb && !ersterNeu) ersterNeu = li;
						li.hidden = !an;
						if (an) gezeigt++;
					});
					gruppen.forEach(function (g) {
						g.hidden = !g.querySelector('li:not([hidden])');
					});
					var treffer = items.filter(passt).length;
					var rest = treffer - gezeigt;
					mehr.hidden = rest <= 0;
					mehrBtn.textContent = 'Mehr anzeigen (noch ' + rest + ')';
					return ersterNeu;
				}

				document.addEventListener('blog:filter', function () { limit = paket(); zeichnen(); balken(); });

				// Klick auf einen Balken: genug Pakete einblenden, bis der Jahres-Titel da ist, dann hinscrollen.
				document.addEventListener('ju:wahl', function (e) {
					var jahr = e.detail.jahr;
					var davor = items.filter(function (li) { return passt(li) && Number(li.getAttribute('data-jahr')) > jahr; }).length;
					var drin = items.some(function (li) { return passt(li) && Number(li.getAttribute('data-jahr')) === jahr; });
					var titel = document.getElementById('jahr-' + jahr);
					if (!drin || !titel) return;
					e.preventDefault();
					while (limit < davor + 1) limit += paket();
					zeichnen();
					titel.setAttribute('tabindex', '-1');
					var ruhig = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
					titel.scrollIntoView({ behavior: ruhig ? 'auto' : 'smooth', block: 'start' });
					titel.focus({ preventScroll: true });
					speichern();
				});

				function weiter(mitFokus) {
					var vorher = Math.min(limit, items.length);
					limit += paket();
					var neu = zeichnen(vorher);
					if (mitFokus && neu) {
						var a = neu.querySelector('a');
						if (a) a.focus();
					}
				}
				mehrBtn.addEventListener('click', function () { weiter(true); });
				if ('IntersectionObserver' in window) {
					new IntersectionObserver(function (es) {
						if (es[0].isIntersecting && !mehr.hidden) weiter(false);
					}, { rootMargin: '0px 0px 200px 0px' }).observe(sentinel);
				}

				limit = paket();
				zeichnen();
				balken();

				// Ansicht merken (Anzahl sichtbar + Scrollposition) und nach «Zurück» wiederherstellen.
				var key = function () { return 'blogview:' + location.pathname + location.search; };
				try { history.scrollRestoration = 'manual'; } catch (e) {}
				var speichern = function () {
					try { sessionStorage.setItem(key(), JSON.stringify({ limit: limit, y: Math.round(window.scrollY) })); } catch (e) {}
				};
				window.addEventListener('pagehide', speichern);
				document.addEventListener('visibilitychange', function () { if (document.visibilityState === 'hidden') speichern(); });
				var nav = performance.getEntriesByType && performance.getEntriesByType('navigation')[0];
				if (nav && nav.type === 'back_forward') {
					try {
						var alt = JSON.parse(sessionStorage.getItem(key()) || 'null');
						if (alt && alt.limit) {
							limit = alt.limit;
							zeichnen();
							window.scrollTo(0, alt.y || 0);
						}
					} catch (e) {}
				}
			})();
		</script>
	</body>
</html>
