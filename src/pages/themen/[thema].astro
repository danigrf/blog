---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import PostList from '../../components/PostList.astro';
import { getThemen } from '../../lib/posts';

export async function getStaticPaths() {
	const themen = await getThemen();
	return themen.map((thema) => ({
		params: { thema: thema.slug },
		props: { thema },
	}));
}

const { thema } = Astro.props;
const anzahl = thema.posts.length === 1 ? '1 Beitrag' : `${thema.posts.length} Beiträge`;
---

<!doctype html>
<html lang="de-CH">
	<head>
		<BaseHead title={`${thema.name} – Daniel Graf`} description={`Beiträge zum Thema ${thema.name}.`} />
	</head>
	<body>
		<Header />
		<main id="inhalt">
			<p class="meta"><a href="/themen/">Alle Themen</a></p>
			<h1>{thema.name}</h1>
			<p class="meta">{anzahl}</p>
			<PostList posts={thema.posts} />
		</main>
		<Footer />
	</body>
</html>
