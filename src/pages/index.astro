	<body>
		<Header />
		<main>
			<h1>Daniel Graf</h1>
			<p>Notizen zu direkter und digitaler Demokratie.</p>
			<p>
				<a href="/blog/">Zu den Beiträgen</a>
			</p>
		</main>
		<Footer />
	</body>
</html>
