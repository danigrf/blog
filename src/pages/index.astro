---
// Startseite (Design A6 «Hellblau», gewählt 01.11.2026).
// Reihenfolge: Intro · Woran ich arbeite · Ausgewählte Texte · Neueste Beiträge (3) · Medienberichte (3).
// Highlights: Frontmatter «highlight» (Rang). Projekte: src/data/projekte.json.
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import MedienLogo from '../components/MedienLogo.astro';
import Sozial from '../components/Sozial.astro';
import Titelbild from '../components/Titelbild.astro';
import portrait from '../assets/ueber-mich/daniel-graf.jpg';
import tamediaBild from '../assets/aktion/tamedia.jpg';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { datumLang, FORMAT, medienDatum, startseitenDaten } from '../lib/startseite';
import { kurz } from '../lib/posts';
import '../styles/start.css';

const d = await startseitenDaten();
const [aufmacher, ...weitere] = d.highlights;
const portraitAlt = 'Daniel Graf mit Brille und schwarzem T-Shirt, die Arme verschränkt, vor einer hellen Wand';
---

<!doctype html>
<html lang="de-CH">
	<head>
		<BaseHead title={`${SITE_TITLE} – Prototyping for democracy`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main id="inhalt" class="start">
			<section class="aktion" aria-labelledby="aktion-titel">
				<div class="wrap">
					<a class="aktion-bild" href="https://rettet-unsere-medien.ch/tamedia" tabindex="-1" aria-hidden="true">
						<Image src={tamediaBild} alt="" widths={[480, 800, 1200]} sizes="(max-width: 760px) 100vw, 1100px" loading="eager" />
					</a>
					<div class="aktion-text">
						<h2 id="aktion-titel">Heute, 11 Uhr: Warnstreik bei Tamedia</h2>
						<p>Solidarität zeigen, vor Ort oder online.</p>
						<a class="aktion-knopf" href="https://rettet-unsere-medien.ch/tamedia">Mitmachen</a>
					</div>
				</div>
			</section>

			<section class="intro wrap raster" aria-labelledby="intro-titel">
				<div class="intro-text">
					<h1 id="intro-titel">Prototyping for democracy</h1>
					<p class="lead">
						Wie gelingt das Update unseres politischen Systems? Diese Frage treibt mich an. 2015 habe ich deshalb die Plattform <a href="https://wecollect.ch">WeCollect.ch</a> gestartet und später die <a href="https://www.demokratie.ch">Stiftung für direkte Demokratie</a> mitgegründet. Heute setze ich mich für die Einführung von <span class="nw">E-Collecting</span> ein und engagiere mich für einen <a href="https://bevoelkerungsrat-basel.ch/">Bevölkerungsrat in Basel</a>. Hier teile ich meine Gedanken, Projekte und Prototypen für eine co-kreative Demokratie.
					</p>
					<Sozial />
				</div>
				<figure class="intro-bild">
					<Image src={portrait} alt={portraitAlt} widths={[360, 540, 800, 1000]} sizes="(max-width: 760px) 100vw, (min-width: 1024px) 40vw, 320px" loading="eager" fetchpriority="high" />
					<figcaption>Foto: Katharina Schillinger</figcaption>
				</figure>
			</section>

			{
				d.projekte.length > 0 && (
					<section class="abschnitt wrap" aria-labelledby="projekte-titel">
						<h2 id="projekte-titel">Woran ich dran bin</h2>
						<ul class="projekte" role="list">
							{d.projekte.map((p) => (
								<li>
									<h3>{p.name}</h3>
									<p class="teaser">{p.kurz}</p>
									{p.themaAnzahl > 0 && <a class="mehr-link" href={`/themen/${p.themaSlug}/`}>Beiträge zum Thema</a>}
									{p.themenLinks.length > 0 && (
										<p class="hashtags">
											{p.themenLinks.map((t) => (
												<a href={`/themen/${t.slug}/`}>#{t.name}</a>
											))}
										</p>
									)}
								</li>
							))}
						</ul>
					</section>
				)
			}

			{
				aufmacher && (
					<section class="band" aria-labelledby="hl-titel">
						<div class="wrap">
							<h2 id="hl-titel">Ausgewählte Texte</h2>
							<div class={`hl hl-${d.highlights.length}`}>
								<a class="hl-gross" href={`/blog/${aufmacher.id}/`}>
									<Titelbild post={aufmacher} class="r32" sizes="(max-width: 760px) 100vw, 680px" />
									<span class="meta">{datumLang(aufmacher.data.pubDate)}{aufmacher.data.tags[0] && ` · ${aufmacher.data.tags[0]}`}</span>
									<span class="hl-titel-gross">{aufmacher.data.title}</span>
									<span class="teaser">{kurz(aufmacher.data.description, 220)}</span>
								</a>
								{weitere.length > 0 && (
									<div class="hl-klein">
										{weitere.map((p) => (
											<a href={`/blog/${p.id}/`}>
												<Titelbild post={p} class="r32 nur-desktop" sizes="400px" />
												<span class="meta">{datumLang(p.data.pubDate)}{p.data.tags[0] && ` · ${p.data.tags[0]}`}</span>
												<span class="hl-titel-klein">{p.data.title}</span>
											</a>
										))}
									</div>
								)}
							</div>
						</div>
					</section>
				)
			}

			<div class="listen wrap">
			<section class="abschnitt liste-neueste" aria-labelledby="neueste-titel">
				<h2 id="neueste-titel">Neueste Beiträge</h2>
				<ul class="pliste" role="list">
					{
						d.neueste.map((p) => (
							<li>
								<a href={`/blog/${p.id}/`}>
									<Titelbild post={p} class="r32 pl-bild" widths={[184, 368]} sizes="(max-width: 760px) 88px, (min-width: 1024px) 120px, 184px" />
									<span class="pl-text">
										<span class="meta">{datumLang(p.data.pubDate)}</span>
										<span class="pl-titel">{p.data.title}</span>
										<span class="pl-desc">{p.data.description}</span>
									</span>
								</a>
							</li>
						))
					}
				</ul>
				<p class="alle-link"><a href="/blog/">Alle Beiträge →</a></p>
			</section>

			<section class="abschnitt liste-medien" aria-labelledby="berichte-titel">
				<h2 id="berichte-titel">Medienberichte</h2>
				<ul class="pliste pliste-medien" role="list">
					{
						d.medienNeu.map((m) => (
							<li>
								<a href={m.link} rel="noopener">
									<MedienLogo medium={m.medium} />
									<span class="pl-text">
										<span class="meta">{medienDatum(m)} · {FORMAT[m.format]}{m.abo ? ' · Abo' : ''}</span>
										<span class="pl-titel">{m.titel}</span>
										<span class="pl-desc">{m.medium}</span>
									</span>
								</a>
							</li>
						))
					}
				</ul>
				<p class="alle-link"><a href="/medien/">Alle Medienberichte →</a></p>
			</section>
			</div>
		</main>
		<Footer />
	</body>
</html>
