---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import PostList from '../components/PostList.astro';
import { getPosts } from '../lib/posts';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getPosts()).slice(0, 5);

// Strukturierte Daten: nur Angaben, die auf dieser Seite stehen.
const start = new URL('/', Astro.site).href;
const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Person',
			'@id': `${start}#person`,
			name: 'Daniel Graf',
			url: start,
			description: 'Startete 2015 die Plattform WeCollect.ch und gründete die Stiftung für direkte Demokratie mit.',
		},
		{
			'@type': 'WebSite',
			'@id': `${start}#website`,
			name: SITE_TITLE,
			url: start,
			description: SITE_DESCRIPTION,
			inLanguage: 'de-CH',
			author: { '@id': `${start}#person` },
			publisher: { '@id': `${start}#person` },
		},
	],
};
---

<!doctype html>
<html lang="de-CH">
	<head>
		<BaseHead title={`${SITE_TITLE} – Prototyping for democracy`} description={SITE_DESCRIPTION} jsonLd={jsonLd} />
		<style>
			.intro {
				margin-bottom: 3rem;
			}
			.intro h1 {
				font-size: 2.6rem;
				margin-bottom: 0.4rem;
			}
			.lead {
				font-size: 1.4rem;
				line-height: 1.45;
				color: var(--muted);
				margin: 0;
			}
			.kurz {
				margin: 1.25rem 0 0;
			}
			.section-head {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				margin: 0 0 0.75rem;
			}
			.section-head h2 {
				margin: 0;
				font-size: 1.1rem;
			}
			.section-head a {
				font-family: var(--sans);
				font-size: 0.95rem;
			}
			@media (max-width: 560px) {
				.intro h1 {
					font-size: 2.1rem;
				}
				.lead {
					font-size: 1.2rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main id="inhalt">
			<section class="intro">
				<h1>Prototyping for democracy</h1>
				<p class="kurz">
					Ich beschäftige mich seit langem damit, wie ein Update der Demokratie aussehen könnte. 2015 habe ich die Plattform <a href="https://wecollect.ch">WeCollect.ch</a> gestartet und später die <a href="https://www.demokratie.ch">Stiftung für direkte Demokratie</a> mitgegründet. Aktuell engagiere ich mich für die Einführung von E-Collecting und begleite den Aufbau eines <a href="https://bevoelkerungsrat-basel.ch/">Bevölkerungsrats in Basel</a>. Hier teile ich meine Gedanken, Projekte und Prototypen für eine co-kreative Demokratie.
				</p>
			</section>
			<section aria-labelledby="neueste">
				<div class="section-head">
					<h2 id="neueste">Neueste Beiträge</h2>
					<a href="/blog/">Alle Beiträge</a>
				</div>
				<PostList posts={posts} />
			</section>
		</main>
		<Footer />
	</body>
</html>
