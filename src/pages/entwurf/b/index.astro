---
import { Image } from 'astro:assets';
import LayoutB from '../../../components/entwurf/LayoutB.astro';
import Titelbild from '../../../components/Titelbild.astro';
import portrait from '../../../assets/ueber-mich/daniel-graf.jpg';
import logos from '../../../data/medien-logos.json';
import { datumIso, datumPunkt, FORMAT, medienDatum, startseitenDaten } from '../../../lib/startseite';
import { kurz, themaSlug } from '../../../lib/posts';

const d = await startseitenDaten();
const portraitAlt = 'Daniel Graf mit Brille und schwarzem T-Shirt, die Arme verschränkt, vor einer hellen Wand';
const gerade = d.projekte.filter((p) => p.status === 'läuft').map((p) => p.name);
const maxJahr = Math.max(1, ...d.jahre.map((j) => j.n));
const jetzt = d.heute.getFullYear();
const grafikText = `Beiträge pro Jahr: ${d.jahre.map((j) => `${j.jahr}: ${j.n}`).join(', ')}`;

function logoFuer(medium: string): string | null {
	const m = logos.medien as Record<string, string>;
	let key = m[medium];
	if (!key) key = Object.entries(logos.praefix as Record<string, string>).find(([pre]) => medium.startsWith(pre))?.[1] as string;
	return key ? `/logos/${key}.png` : null;
}
---

<LayoutB title="Entwurf B «Maschinenraum» – Daniel Graf" build={d.build}>
	<section class="intro wrap raster" aria-labelledby="intro-titel">
		<div class="intro-text">
			<h1 id="intro-titel">Daniel Graf</h1>
			<p class="unterzeile">Prototyping for democracy. Aus dem Maschinenraum, seit 2012.</p>
			<p class="lead">
				2015 habe ich die Plattform <a href="https://wecollect.ch">WeCollect.ch</a> gestartet und später die <a href="https://www.demokratie.ch">Stiftung für direkte Demokratie</a> mitgegründet. Aktuell engagiere ich mich für die Einführung von E-Collecting und begleite den Aufbau eines <a href="https://bevoelkerungsrat-basel.ch/">Bevölkerungsrats in Basel</a>. Hier teile ich meine Gedanken, Projekte und Prototypen für eine co-kreative Demokratie.
			</p>
		</div>
		<aside class="status" aria-label="Status">
			<Image src={portrait} alt={portraitAlt} widths={[300, 480, 720]} sizes="(max-width: 760px) 100vw, 300px" loading="eager" fetchpriority="high" />
			<dl>
				<dt>ort</dt><dd>Basel</dd>
				<dt>seit</dt><dd><span class="nw">2012</span> · <span class="nw">{d.anzahl} Beiträge</span> · <span class="nw">{d.medienAnzahl} Medien</span></dd>
				{gerade.length > 0 && <><dt>gerade</dt><dd>{gerade.join(', ')}</dd></>}
				<dt>stand</dt><dd>{datumPunkt(d.heute)}</dd>
				<dt>foto</dt><dd>Katharina Schillinger</dd>
			</dl>
		</aside>
	</section>

	{
		d.projekte.length > 0 && (
			<section class="abschnitt wrap" aria-labelledby="projekte-titel">
				<h2 id="projekte-titel">Projekte</h2>
				<table class="projekte">
					<thead>
						<tr><th scope="col">Projekt</th><th scope="col">Rolle</th><th scope="col">Status</th><th scope="col">seit</th><th scope="col">letzter Beitrag</th></tr>
					</thead>
					<tbody>
						{d.projekte.map((p) => (
							<tr>
								<th scope="row"><a href={`/themen/${p.themaSlug}/`}>{p.name}</a></th>
								<td>{p.rolle}</td>
								<td><span class={`quadrat ${p.status === 'ruht' ? 'ruht' : 'aktiv'}`} aria-hidden="true" />{p.status}</td>
								<td>{p.seit || '–'}</td>
								<td>{p.letzterBeitrag ? <a href={`/blog/${p.letzterBeitrag.id}/`}>{datumIso(p.letzterBeitrag.data.pubDate)}</a> : '–'}</td>
							</tr>
						))}
					</tbody>
				</table>
			</section>
		)
	}

	{
		d.highlights.length > 0 && (
			<section class="abschnitt wrap" aria-labelledby="pin-titel">
				<h2 id="pin-titel">Angepinnt</h2>
				<ul class={`karten karten-${d.highlights.length}`} role="list">
					{d.highlights.map((p) => (
						<li>
							<a href={`/blog/${p.id}/`}>
								<Titelbild post={p} class="r11" sizes="(max-width: 760px) 96px, 380px" />
								<span class="k-text">
									<span class="meta">#{d.nummer.get(p.id)} · {datumPunkt(p.data.pubDate)}</span>
									<span class="k-titel">{p.data.title}</span>
									<span class="teaser">{kurz(p.data.description, 160)}</span>
								</span>
							</a>
						</li>
					))}
				</ul>
			</section>
		)
	}

	<section class="abschnitt wrap" aria-labelledby="log-titel">
		<h2 id="log-titel">Log</h2>
		<ol class="log" role="list">
			{
				d.neue.map((p) => (
					<li>
						<a href={`/blog/${p.id}/`}>
							<span class="l-datum">{datumIso(p.data.pubDate)}</span>
							<span class="l-titel">{p.data.title}</span>
							<span class="l-slug">{p.data.tags[0] ? themaSlug(p.data.tags[0]) : ''}</span>
						</a>
					</li>
				))
			}
		</ol>
		<p class="alle"><a href="/blog/">alle {d.anzahl} Beiträge →</a></p>
		<figure class="jahre">
			<div class="jahre-plot" role="img" aria-label={grafikText}>
				{
					d.jahre.map((j) => (
						<span
							class={`balken${j.jahr === jetzt ? ' jetzt' : ''}${j.n === 0 ? ' null' : ''}`}
							style={`height:${Math.max(j.n ? 2 : 0, Math.round((j.n / maxJahr) * 40))}px`}
							title={`${j.jahr}: ${j.n}`}
						/>
					))
				}
			</div>
			<figcaption class="jahre-achse">
				<span>{d.jahre[0].jahr}</span><span>Beiträge pro Jahr</span><span>{d.jahre.at(-1)!.jahr}</span>
			</figcaption>
		</figure>
	</section>

	{
		d.medienHighlights.length > 0 && (
			<section class="band" aria-labelledby="mhl-titel">
				<div class="wrap">
					<h2 id="mhl-titel">Medien, ausgewählt</h2>
					<ul class="medien-hl" role="list">
						{d.medienHighlights.map((m) => (
							<li>
								<a href={m.link} rel="noopener">
									<span class="meta">{m.id} · {m.format} · {medienDatum(m, 'punkt')}{m.abo ? ' · abo' : ''}</span>
									<span class="mh-medium">{logoFuer(m.medium) && <img class="qlogo" src={logoFuer(m.medium)!} alt="" width="18" height="18" loading="lazy" />}{m.medium}</span>
									<span class="mh-titel">«{m.titel}»</span>
								</a>
							</li>
						))}
					</ul>
				</div>
			</section>
		)
	}

	<section class="abschnitt wrap" aria-labelledby="mneu-titel">
		<h2 id="mneu-titel">Medien, neu</h2>
		<ol class="log log-medien" role="list">
			{
				d.medienNeu.map((m) => (
					<li>
						<a href={m.link} rel="noopener">
							<span class="l-datum">{medienDatum(m, 'iso')}</span>
							<span class="l-medium">{m.medium}</span>
							<span class="l-titel">{m.titel}</span>
							<span class="l-slug">{m.format}{m.abo ? ' · abo' : ''}</span>
						</a>
					</li>
				))
			}
		</ol>
		<p class="alle"><a href="/medien/">alle {d.medienAnzahl} Medienbeiträge →</a></p>
	</section>
</LayoutB>
