---
// Übersicht der Design-Entwürfe (nicht verlinkt, noindex, nicht in der Sitemap).
import EntwurfHead from '../../components/entwurf/EntwurfHead.astro';

const varianten = [
	{ k: 'a', name: 'A «Feuilleton»', idee: 'Wochenzeitung: grosse Serif-Titel, Aufmacher, Pressespiegel. Daniel als Autor.' },
	{ k: 'b', name: 'B «Maschinenraum»', idee: 'Logbuch einer Werkstatt: Mono führt, echte Daten sind die Deko. Daniel als Bauender.' },
	{ k: 'c', name: 'C «Wegweiser»', idee: 'Basler Strassenschild, Liniennetz der Projekte, Abfahrtstafel. Daniel als Ortskundiger. Empfehlung Iris.' },
];
// Runde 3: Signalfarben (Signalgelb, Orange, Hellblau), Schrift Archivo wie A1.
const runde3 = [
	{ k: 'a4', name: 'A4 «Signalgelb»', idee: 'Gelb führt: Band Signalgelb, Zeitungskopf Hellblau, Projekt-Balken Orange.' },
	{ k: 'a5', name: 'A5 «Orange»', idee: 'Orange führt: Band Orange, Zeitungskopf Signalgelb, Projekt-Balken Hellblau.' },
	{ k: 'a6', name: 'A6 «Hellblau»', idee: 'Hellblau führt: Band Hellblau, Zeitungskopf Orange, Projekt-Balken Signalgelb. Empfehlung Iris für «lebendig, aber nicht laut».' },
];
// Runde 2: Daniel wählt A, mit lebendigeren Farben und modernerer Schrift.
const runde2 = [
	{ k: 'a1', name: 'A1 «Zine»', idee: 'Laut: Fluo-Pink und Riso-Blau, breite Grotesk (Archivo).' },
	{ k: 'a2', name: 'A2 «Sonntag»', idee: 'Etwas lebendiger: Sonnengelb und Burgund, Display-Serif Gloock + Hanken Grotesk. Empfehlung Iris.' },
	{ k: 'a3', name: 'A3 «Garten»', idee: 'Frisch: Lime und Riso-Grün, Atkinson Hyperlegible (für Lesbarkeit gebaut).' },
];
---

<!doctype html>
<html lang="de-CH">
	<head>
		<EntwurfHead title="Entwürfe Startseite – danielgraf.ch" fonts={[]} />
		<style>
			body {
				margin: 0;
				padding: 48px 20px;
				font: 17px/1.5 system-ui, sans-serif;
				background: #fafafa;
				color: #161616;
			}
			main {
				max-width: 40rem;
				margin: 0 auto;
			}
			h1 {
				font-size: 28px;
				margin: 0 0 8px;
			}
			h2 {
				font-size: 20px;
				margin: 40px 0 4px;
			}
			p {
				margin: 0 0 24px;
				color: #555;
			}
			ul {
				list-style: none;
				margin: 0;
				padding: 0;
				border-top: 1px solid #ddd;
			}
			li {
				padding: 16px 0;
				border-bottom: 1px solid #ddd;
			}
			a {
				color: #173fb9;
			}
			strong {
				display: block;
				font-size: 19px;
			}
			span {
				display: block;
				color: #555;
			}
			@media (prefers-color-scheme: dark) {
				body {
					background: #111;
					color: #eee;
				}
				p,
				span {
					color: #aaa;
				}
				ul,
				li {
					border-color: #333;
				}
				a {
					color: #8fa8ff;
				}
			}
		</style>
	</head>
	<body>
		<main>
			<h1>Startseite: Entwürfe</h1>
			<h2>Runde 3: Signalfarben</h2>
			<p>Aufbau wie A, Schrift Archivo wie A1, Farben Signalgelb, Orange und Hellblau.</p>
			<ul>
				{
					runde3.map((v) => (
						<li>
							<strong>{v.name}</strong>
							<span>{v.idee}</span>
							<a href={`/entwurf/${v.k}/`}>Startseite</a> · <a href={`/entwurf/${v.k}/artikel/`}>Beispiel-Artikel</a>
						</li>
					))
				}
			</ul>
			<h2>Runde 2: Varianten von A</h2>
			<p>Gleicher Aufbau wie A, andere Farben (Riso-Druckfarben) und Schriften.</p>
			<ul>
				{
					runde2.map((v) => (
						<li>
							<strong>{v.name}</strong>
							<span>{v.idee}</span>
							<a href={`/entwurf/${v.k}/`}>Startseite</a> · <a href={`/entwurf/${v.k}/artikel/`}>Beispiel-Artikel</a>
						</li>
					))
				}
			</ul>
			<h2>Runde 1: drei Richtungen</h2>
			<p>Grund-Design für danielgraf.ch nach Iris’ Spezifikation vom 1.11.2026. Echte Daten, nicht öffentlich verlinkt. Projekte und Blog-Highlights sind vorläufig.</p>
			<ul>
				{
					varianten.map((v) => (
						<li>
							<strong>{v.name}</strong>
							<span>{v.idee}</span>
							<a href={`/entwurf/${v.k}/`}>Startseite</a> · <a href={`/entwurf/${v.k}/artikel/`}>Beispiel-Artikel</a>
						</li>
					))
				}
			</ul>
		</main>
	</body>
</html>
