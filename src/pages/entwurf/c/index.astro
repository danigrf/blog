---
import { Image } from 'astro:assets';
import LayoutC from '../../../components/entwurf/LayoutC.astro';
import Titelbild from '../../../components/entwurf/Titelbild.astro';
import portrait from '../../../assets/ueber-mich/daniel-graf.jpg';
import { datumPunkt, FORMAT, medienDatum, medienMeta, startseitenDaten } from '../../../lib/entwurf';
import { kurz } from '../../../lib/posts';

const d = await startseitenDaten();
const [gross, ...klein] = d.highlights;
const portraitAlt = 'Daniel Graf mit Brille und schwarzem T-Shirt, die Arme verschränkt, vor einer hellen Wand';
const jetzt = String(d.heute.getFullYear());
// Stationen: aus projekte.json; fehlen sie, nur Start («seit …») und «heute» (Spec C, Abschnitt 2).
const linien = d.projekte.map((p) => ({
	...p,
	halte: [...(p.stationen.length ? p.stationen : [{ jahr: p.seit, label: 'Start' }]), { jahr: jetzt, label: 'heute', heute: true }],
}));
---

<LayoutC title="Entwurf C «Wegweiser» – Daniel Graf" anzahl={d.anzahl}>
	<section class="wrap intro" aria-labelledby="schild-name">
		<div class="schild-box">
			<div class="schild">
				<div class="schild-innen">
					<h1 id="schild-name">Daniel Graf</h1>
					<p>
						<span>Demokratie-Aktivist, 2015 Gründer von WeCollect</span>
						<span>Stiftungsrat der Stiftung für direkte Demokratie, Basel</span>
					</p>
				</div>
			</div>
		</div>
		<div class="intro-raster">
			<figure class="intro-bild">
				<Image src={portrait} alt={portraitAlt} widths={[360, 540, 800]} sizes="(max-width: 760px) 100vw, 380px" loading="eager" fetchpriority="high" />
				<figcaption>Foto: Katharina Schillinger</figcaption>
			</figure>
			<div class="intro-text">
				<p>
					Ich beschäftige mich seit langem damit, wie ein Update der Demokratie aussehen könnte. Aktuell engagiere ich mich für die Einführung von E-Collecting und begleite den Aufbau eines <a href="https://bevoelkerungsrat-basel.ch/">Bevölkerungsrats in Basel</a>. Hier teile ich meine Gedanken, Projekte und Prototypen für eine co-kreative Demokratie.
				</p>
			</div>
		</div>
	</section>

	{
		linien.length > 0 && (
			<section class="abschnitt wrap" aria-labelledby="linien-titel">
				<h2 id="linien-titel">Linien</h2>
				<ul class="netz" role="list">
					{linien.map((l) => (
						<li class="linie">
							<h3 class="linie-name">{l.name}</h3>
							<ol class="halte" aria-label={`Stationen ${l.name}`}>
								{l.halte.map((h) => (
									<li class={'heute' in h ? 'halt halt-heute' : 'halt'}>
										<span class="halt-jahr">{h.jahr}</span>
										<span class="halt-strich" aria-hidden="true" />
										<span class="halt-name">{h.label}</span>
									</li>
								))}
							</ol>
							<a class="linie-link" href={`/themen/${l.themaSlug}/`}>Beiträge →</a>
						</li>
					))}
				</ul>
			</section>
		)
	}

	{
		gross && (
			<section class="abschnitt wrap" aria-labelledby="ausgewaehlt-titel">
				<h2 id="ausgewaehlt-titel">Ausgewählt</h2>
				<div class={`hl hl-${d.highlights.length}`}>
					<a class="hl-gross" href={`/blog/${gross.id}/`}>
						<Titelbild post={gross} class="r43" sizes="(max-width: 760px) 100vw, 680px" />
						<span class="meta">{datumPunkt(gross.data.pubDate)}{gross.data.tags[0] && ` · ${gross.data.tags[0]}`}</span>
						<span class="hl-titel-gross">{gross.data.title}</span>
						<span class="teaser">{kurz(gross.data.description, 220)}</span>
					</a>
					{klein.length > 0 && (
						<div class="hl-klein">
							{klein.map((p) => (
								<a href={`/blog/${p.id}/`}>
									<Titelbild post={p} class="r43" sizes="(max-width: 760px) 100vw, 200px" />
									<span class="hl-k-text">
										<span class="meta">{datumPunkt(p.data.pubDate)}{p.data.tags[0] && ` · ${p.data.tags[0]}`}</span>
										<span class="hl-titel-klein">{p.data.title}</span>
									</span>
								</a>
							))}
						</div>
					)}
				</div>
			</section>
		)
	}

	<section class="abschnitt wrap" aria-labelledby="abfahrt-titel">
		<h2 id="abfahrt-titel">Abfahrt</h2>
		<table class="tafel">
			<thead>
				<tr><th scope="col">Datum</th><th scope="col">Beitrag</th><th scope="col" class="t-thema">Thema</th></tr>
			</thead>
			<tbody>
				{
					d.neue.map((p) => (
						<tr>
							<td class="t-datum">{datumPunkt(p.data.pubDate)}</td>
							<td class="t-titel"><a href={`/blog/${p.id}/`}>{p.data.title}</a></td>
							<td class="t-thema">{p.data.tags[0] ?? ''}</td>
						</tr>
					))
				}
			</tbody>
		</table>
		<p class="alle"><a href="/blog/">Alle Beiträge →</a></p>
	</section>

	{
		d.medienHighlights.length > 0 && (
			<section class="band" aria-labelledby="medien-titel">
				<div class="wrap">
					<h2 id="medien-titel">Medien</h2>
					<ul class={`plakate plakate-${d.medienHighlights.length}`} role="list">
						{d.medienHighlights.map((m) => (
							<li>
								<a href={m.link} rel="noopener">
									<span class="pl-medium">{m.medium}</span>
									<span class="pl-titel">«{m.titel}»</span>
									<span class="meta">{medienMeta(m)}</span>
								</a>
							</li>
						))}
					</ul>
				</div>
			</section>
		)
	}

	<section class="abschnitt wrap" aria-labelledby="mneu-titel">
		<h2 id="mneu-titel">Medien, neu</h2>
		<table class="tafel tafel-medien">
			<thead>
				<tr><th scope="col">Datum</th><th scope="col" class="t-medium">Medium</th><th scope="col">Titel</th><th scope="col" class="t-thema">Format</th></tr>
			</thead>
			<tbody>
				{
					d.medienNeu.map((m) => (
						<tr>
							<td class="t-datum">{medienDatum(m, 'punkt')}</td>
							<td class="t-medium">{m.medium}</td>
							<td class="t-titel"><a href={m.link} rel="noopener">{m.titel}</a></td>
							<td class="t-thema">{FORMAT[m.format]}{m.abo ? ' · Abo' : ''}</td>
						</tr>
					))
				}
			</tbody>
		</table>
		<p class="alle"><a href="/medien/">Alle Medienbeiträge →</a></p>
	</section>
</LayoutC>
