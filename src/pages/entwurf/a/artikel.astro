---
import { render } from 'astro:content';
import * as bausteine from '../../../components/bausteine';
import LayoutA from '../../../components/entwurf/LayoutA.astro';
import { datumLang, startseitenDaten } from '../../../lib/entwurf';
import { themaSlug } from '../../../lib/posts';

const d = await startseitenDaten();
const post = d.artikel;
const { Content } = await render(post);
---

<LayoutA title={`${post.data.title} – Entwurf A`} anzahl={d.anzahl} heute={d.heute} zeitungskopf={false}>
	<article class="artikel wrap">
		<header class="artikel-kopf">
			<p class="meta">
				<a href="/entwurf/a/">← Startseite</a> · {datumLang(post.data.pubDate)}
				{post.data.tags[0] && <> · <a href={`/themen/${themaSlug(post.data.tags[0])}/`}>{post.data.tags[0]}</a></>}
			</p>
			<h1>{post.data.title}</h1>
		</header>
		<div class="prose">
			<Content components={bausteine} />
		</div>
		{
			post.data.tags.length > 0 && (
				<p class="artikel-themen">
					<span>Themen: </span>
					{post.data.tags.map((t, i) => (
						<>
							{i > 0 && ' · '}
							<a href={`/themen/${themaSlug(t)}/`}>{t}</a>
						</>
					))}
				</p>
			)
		}
	</article>
</LayoutA>
