---
// Links zu Daniels Profilen: kleines einfarbiges Icon + Text (keine Markenfarben).
import { SOZIAL } from '../consts';
import SozialLink from './SozialLink.astro';
---

<p class="sozial">
	{
		SOZIAL.map((s, i) => (
			<>
				{i > 0 && <span aria-hidden="true"> · </span>}
				<SozialLink name={s.name} url={s.url} />
			</>
		))
	}
</p>
