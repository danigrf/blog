---
// Logo eines Mediums für die Startseite (48 px, quadratisch).
// Zuordnung wie auf /medien/ (lib/medienlogo.ts, Dateien in public/logos/); ohne Logo: graues Quadrat mit Initialen.
import { logoFuer } from '../lib/medienlogo';

interface Props {
	medium: string;
}
const { medium } = Astro.props;
const pfad = logoFuer(medium);
// Initialen: Anfangsbuchstaben der ersten zwei Wörter, die gross oder mit Ziffer beginnen
const woerter = medium.split(/[\s\-–/]+/).filter((w) => /^[A-ZÄÖÜ0-9]/.test(w));
const initialen = (woerter.length ? woerter : [medium])
	.slice(0, 2)
	.map((w) => w[0])
	.join('')
	.toUpperCase();
---

{
	pfad ? (
		<img class="medien-logo" src={pfad} alt="" width="48" height="48" loading="lazy" decoding="async" />
	) : (
		<span class="medien-logo medien-logo-leer" aria-hidden="true">{initialen}</span>
	)
}
