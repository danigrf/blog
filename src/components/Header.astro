---
// Kopf (Design A6): Name mit Unterzeile links, Navigation rechts. Styles in global.css (.kopf).
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
<header class="kopf wrap">
	<a class="kopf-marke" href="/">
		<span class="marke-name">{SITE_TITLE}</span>
		<span class="marke-zeile">Prototyping for democracy</span>
	</a>
	<nav aria-label="Hauptnavigation">
		<HeaderLink href="/blog">Blog</HeaderLink>
		<HeaderLink href="/medien">Medien</HeaderLink>
		<HeaderLink href="/themen">Themen</HeaderLink>
		<HeaderLink href="/about">Über mich</HeaderLink>
	</nav>
</header>
