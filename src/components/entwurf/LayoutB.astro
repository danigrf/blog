---
// Entwurf B «Maschinenraum»: IBM Plex Mono + Source Serif 4.
import '../../styles/entwurf-b.css';
import EntwurfHead from './EntwurfHead.astro';
import EntwurfLeiste from './EntwurfLeiste.astro';

interface Props {
	title: string;
	build: { commit: string; datum: string; zeit: string };
}
const { title, build } = Astro.props;
---

<!doctype html>
<html lang="de-CH" class="vb">
	<head>
		<EntwurfHead title={title} fonts={['--entwurf-mono', '--entwurf-serif']} />
	</head>
	<body>
		<EntwurfLeiste variante="B «Maschinenraum»" />
		<a class="skip" href="#inhalt">Zum Inhalt springen</a>
		<header class="kopf">
			<div class="wrap kopf-innen">
				<a class="marke" href="/entwurf/b/">danielgraf.ch <span class="badge">v1.3</span></a>
				<nav aria-label="Hauptnavigation">
					<a href="/blog/">/blog</a>
					<a href="/medien/">/medien</a>
					<a href="/themen/">/themen</a>
					<a href="/about/">/über-mich</a>
				</nav>
			</div>
		</header>
		<main id="inhalt">
			<slot />
		</main>
		<footer class="fuss">
			<p class="wrap">
				<span class="f-teil">build {build.datum} {build.zeit}</span>
				<span class="f-teil">commit {build.commit}</span>
				<span class="f-teil">astro</span>
				<span class="f-teil">cloudflare</span>
				<span class="f-teil"><a href="/rss.xml">rss</a></span>
				<span class="f-teil"><a href="/datenschutz/">datenschutz</a></span>
			</p>
		</footer>
	</body>
</html>
