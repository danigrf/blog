---
// Startseite Entwurf A (und Varianten A1–A3 über Props).
import { Image } from 'astro:assets';
import LayoutA from './LayoutA.astro';
import Titelbild from './Titelbild.astro';
import portrait from '../../assets/ueber-mich/daniel-graf.jpg';
import { datumLang, medienDatum, medienMeta, startseitenDaten, FORMAT } from '../../lib/startseite';
import { kurz } from '../../lib/posts';

interface Props {
	basis?: string;
	label?: string;
	klasse?: string;
	fonts?: string[];
	/** A6 (Daniels Wahl): «Neueste Beiträge» und «Medienberichte» je 3 im Aufbau der Live-Startseite, ohne Pressespiegel. */
	kompakt?: boolean;
}
const { basis = '/entwurf/a/', label = 'A «Feuilleton»', klasse = 'va', fonts, kompakt = false } = Astro.props;
const d = await startseitenDaten();
const [aufmacher, ...weitere] = d.highlights;
const portraitAlt = 'Daniel Graf mit Brille und schwarzem T-Shirt, die Arme verschränkt, vor einer hellen Wand';
---

<LayoutA title={`Entwurf ${label} – Daniel Graf`} anzahl={d.anzahl} heute={d.heute} {basis} {label} {klasse} fonts={fonts as any}>
	<section class="intro wrap raster" aria-labelledby="intro-titel">
		<div class="intro-text">
			<p class="dachzeile">Daniel Graf, Basel</p>
			<h1 id="intro-titel">Wie gelingt das Update der Demokratie?</h1>
			<p class="lead">
				2015 habe ich die Plattform <a href="https://wecollect.ch">WeCollect.ch</a> gestartet und später die <a href="https://www.demokratie.ch">Stiftung für direkte Demokratie</a> mitgegründet. Aktuell engagiere ich mich für die Einführung von E-Collecting und begleite den Aufbau eines <a href="https://bevoelkerungsrat-basel.ch/">Bevölkerungsrats in Basel</a>. Hier teile ich meine Gedanken, Projekte und Prototypen für eine co-kreative Demokratie.
			</p>
		</div>
		<figure class="intro-bild">
			<Image src={portrait} alt={portraitAlt} widths={[360, 540, 800]} sizes="(max-width: 760px) 100vw, 320px" loading="eager" fetchpriority="high" />
			<figcaption>Foto: Katharina Schillinger</figcaption>
		</figure>
	</section>

	{
		d.projekte.length > 0 && (
			<section class="abschnitt wrap" aria-labelledby="projekte-titel">
				<h2 id="projekte-titel">Woran ich arbeite</h2>
				<ul class="projekte" role="list">
					{d.projekte.map((p) => (
						<li>
							<h3>{p.name}</h3>
							<p class="teaser">{p.kurz}</p>
							<p class="meta">{p.status}{p.seit && ` · seit ${p.seit}`}</p>
							{p.themaAnzahl > 0 && (
								<a class="mehr" href={`/themen/${p.themaSlug}/`}>Beiträge zum Thema</a>
							)}
						</li>
					))}
				</ul>
			</section>
		)
	}

	{
		aufmacher && (
			<section class="band" aria-labelledby="hl-titel">
				<div class="wrap">
					<h2 id="hl-titel">Ausgewählte Texte</h2>
					<div class={`hl hl-${d.highlights.length}`}>
						<a class="hl-gross" href={`/blog/${aufmacher.id}/`}>
							<Titelbild post={aufmacher} class="r32" sizes="(max-width: 760px) 100vw, 680px" />
							<span class="meta">{datumLang(aufmacher.data.pubDate)}{aufmacher.data.tags[0] && ` · ${aufmacher.data.tags[0]}`}</span>
							<span class="hl-titel-gross">{aufmacher.data.title}</span>
							<span class="teaser">{kurz(aufmacher.data.description, 220)}</span>
						</a>
						{weitere.length > 0 && (
							<div class="hl-klein">
								{weitere.map((p) => (
									<a href={`/blog/${p.id}/`}>
										<Titelbild post={p} class="r32 nur-desktop" sizes="400px" />
										<span class="meta">{datumLang(p.data.pubDate)}{p.data.tags[0] && ` · ${p.data.tags[0]}`}</span>
										<span class="hl-titel-klein">{p.data.title}</span>
									</a>
								))}
							</div>
						)}
					</div>
				</div>
			</section>
		)
	}

	{
		kompakt ? (
			<>
				<section class="abschnitt wrap" aria-labelledby="neueste-titel">
					<div class="liste-kopf">
						<h2 id="neueste-titel">Neueste Beiträge</h2>
						<a href="/blog/">Alle Beiträge</a>
					</div>
					<ul class="pliste" role="list">
						{d.neue.slice(0, 3).map((p) => (
							<li>
								<a href={`/blog/${p.id}/`}>
									<span class="pl-text">
										<span class="meta">{datumLang(p.data.pubDate)}</span>
										<span class="pl-titel">{p.data.title}</span>
										<span class="pl-desc">{p.data.description}</span>
									</span>
									<Titelbild post={p} class="r32 pl-bild" widths={[184, 368]} sizes="(max-width: 760px) 88px, 184px" />
								</a>
							</li>
						))}
					</ul>
				</section>
				<section class="abschnitt wrap" aria-labelledby="berichte-titel">
					<div class="liste-kopf">
						<h2 id="berichte-titel">Medienberichte</h2>
						<a href="/medien/">Alle Medienberichte</a>
					</div>
					<ul class="pliste" role="list">
						{d.medienNeuAlle.slice(0, 3).map((m) => (
							<li>
								<a href={m.link} rel="noopener">
									<span class="pl-text">
										<span class="meta">{medienDatum(m, 'lang')} · {FORMAT[m.format]}{m.abo ? ' · Abo' : ''}</span>
										<span class="pl-titel">{m.titel}</span>
										<span class="pl-desc">{m.medium}</span>
									</span>
								</a>
							</li>
						))}
					</ul>
				</section>
			</>
		) : (
			<>
		<section class="abschnitt wrap" aria-labelledby="neu-titel">
			<h2 id="neu-titel">Neu im Blog</h2>
			<ol class="zeilen" role="list">
				{
					d.neue.map((p) => (
						<li>
							<a href={`/blog/${p.id}/`}>
								<span class="z-datum">{datumLang(p.data.pubDate)}</span>
								<span class="z-titel">{p.data.title}</span>
								<span class="z-thema">
									{p.data.tags.slice(0, 2).map((t, i) => (
										<>
											{i > 0 && ' '}
											<span class="z-tag">{t}</span>
										</>
									))}
								</span>
							</a>
						</li>
					))
				}
			</ol>
			<p class="alle"><a href="/blog/">Alle Beiträge →</a></p>
		</section>

		{
			d.medienHighlights.length > 0 && (
				<section class="abschnitt wrap" aria-labelledby="presse-titel">
					<h2 id="presse-titel">Pressespiegel</h2>
					<ul class={`presse presse-${d.medienHighlights.length}`} role="list">
						{d.medienHighlights.map((m) => (
							<li>
								<a href={m.link} rel="noopener">
									<span class="p-medium">{m.medium}</span>
									<span class="p-titel">«{m.titel}»</span>
									<span class="meta">{medienMeta(m)}</span>
								</a>
							</li>
						))}
					</ul>
				</section>
			)
		}

		<section class="abschnitt wrap" aria-labelledby="mneu-titel">
			<h2 id="mneu-titel">Neu in den Medien</h2>
			<ol class="zeilen zeilen-medien" role="list">
				{
					d.medienNeu.map((m) => (
						<li>
							<a href={m.link} rel="noopener">
								<span class="z-datum">{medienDatum(m, 'lang')}</span>
								<em class="z-medium">{m.medium}</em>
								<span class="z-titel">{m.titel}</span>
								<span class="z-thema">{FORMAT[m.format]}{m.abo ? ' · Abo' : ''}</span>
							</a>
						</li>
					))
				}
			</ol>
			<p class="alle"><a href="/medien/">Alle Medienbeiträge →</a></p>
		</section>
			</>
		)
	}
</LayoutA>
