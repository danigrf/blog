---
// Kopf für die Design-Entwürfe: bewusst OHNE global.css, damit jede Variante
// ihr eigenes Styling hat. noindex, keine Canonical-Adresse.
import { Font } from 'astro:assets';

interface Props {
	title: string;
	description?: string;
	fonts: ('--entwurf-serif' | '--entwurf-sans' | '--entwurf-mono' | '--entwurf-grotesk')[];
}
const { title, description = 'Design-Entwurf, nicht öffentlich', fonts } = Astro.props;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="robots" content="noindex, nofollow" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" />
<meta name="color-scheme" content="light dark" />
{fonts.map((f) => <Font cssVariable={f} preload />)}
<title>{title}</title>
<meta name="description" content={description} />
