---
// Titelbild eines Beitrags für die Entwürfe: vorschau ?? heroImage ?? ruhige Platzhalterfläche.
// Seitenverhältnis und Ausschnitt kommen aus dem CSS der Variante (Klasse .tb + Modifikator).
import { Image } from 'astro:assets';
import { type Post, vorschauBild } from '../../lib/posts';

interface Props {
	post: Post;
	class?: string;
	widths?: number[];
	sizes?: string;
	eager?: boolean;
}
const { post, class: klasse = '', widths = [400, 800, 1200], sizes = '(max-width: 700px) 100vw, 50vw', eager = false } = Astro.props;
const bild = vorschauBild(post);
---

<span class={`tb ${klasse}`}>
	{
		bild ? (
			<Image src={bild.src} alt="" widths={widths} sizes={sizes} loading={eager ? 'eager' : 'lazy'} />
		) : (
			<span class="tb-leer" aria-hidden="true">{post.data.pubDate.getFullYear()}</span>
		)
	}
</span>
