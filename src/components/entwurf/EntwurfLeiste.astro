---
// Kleine Hinweisleiste über jedem Entwurf (nur Vorschau, kommt nicht in die echte Seite).
interface Props {
	variante: string;
}
const { variante } = Astro.props;
---

<div class="entwurf-leiste" role="note">
	<span>Entwurf {variante} · nicht öffentlich</span>
	<a href="/entwurf/">alle Entwürfe</a>
</div>
<style>
	.entwurf-leiste {
		display: flex;
		justify-content: space-between;
		gap: 12px;
		padding: 6px 20px;
		font: 14px/1.4 system-ui, sans-serif;
		background: #2b2b2b;
		color: #f2f2f2;
	}
	.entwurf-leiste a {
		color: #f2f2f2;
	}
</style>
