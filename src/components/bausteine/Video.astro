---
// Video (MP4/H.264 oder WebM) aus public/videos/. Kein Autoplay, lädt zuerst nur Metadaten.
// <Video src="/videos/mein-beitrag/clip.mp4" poster="/videos/mein-beitrag/clip.jpg" legende="…" />
interface Props {
	src: string;
	poster?: string;
	legende?: string;
	quelle?: string;
	/** Kurzbeschreibung für Screenreader (optional) */
	beschreibung?: string;
}
const { src, poster, legende, quelle, beschreibung } = Astro.props;
const typ = src.toLowerCase().endsWith('.webm') ? 'video/webm' : 'video/mp4';
---

<figure class="video">
	<video controls preload="metadata" playsinline poster={poster} aria-label={beschreibung ?? legende}>
		<source src={src} type={typ} />
		<p>Ihr Browser kann dieses Video nicht abspielen. <a href={src}>Video herunterladen</a>.</p>
	</video>
	{
		(legende || quelle) && (
			<figcaption>
				{legende && <span class="legende">{legende}</span>}
				{quelle && <span class="quelle">Quelle: {quelle}</span>}
			</figcaption>
		)
	}
</figure>

<style>
	.video {
		margin: 2rem 0;
	}
	video {
		display: block;
		width: 100%;
		height: auto;
		background: #000;
		border-radius: 4px;
	}
	figcaption {
		margin-top: 0.6rem;
		font-family: var(--sans);
		font-size: 0.9rem;
		line-height: 1.45;
		color: var(--muted);
	}
	.legende,
	.quelle {
		display: block;
	}
	.quelle {
		font-family: var(--mono);
		font-size: 0.8rem;
		margin-top: 0.15rem;
	}
</style>
