---
// Fuss (Design A6). Styles in global.css (.fuss).
// Links: Name + Claim + ©, darunter Datenschutz. Rechts: Fussnavigation. Mobil gestapelt.
import { SOZIAL } from '../consts';
import SozialLink from './SozialLink.astro';

const jahr = new Date().getFullYear(); // Build-Jahr
---

<footer class="fuss wrap">
	<div class="fuss-raster">
		<p class="fuss-titel">Daniel Graf <span aria-hidden="true">🚀</span> Prototyping for democracy © {jahr}</p>
		<nav aria-label="Fussnavigation">
			<a href="/blog/">Blog</a>
			<a href="/medien/">Medien</a>
			<a href="/themen/">Themen</a>
			<a href="/about/">Über mich</a>
			<a href="/kontakt/">Kontakt</a>
			<a href="/rss.xml">RSS</a>
			{SOZIAL.map((s) => <SozialLink name={s.name} url={s.url} />)}
		</nav>
		<p class="fuss-ds"><a href="/datenschutz/">Datenschutz</a></p>
	</div>
</footer>
