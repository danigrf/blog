---
const today = new Date();
---

<footer>
	<div class="inner meta">
		<span>&copy; {today.getFullYear()} Daniel Graf</span>
		<a href="/rss.xml">RSS</a>
	</div>
</footer>
<style>
	footer {
		border-top: 1px solid var(--line);
	}
	.inner {
		max-width: calc(var(--measure) + 3rem);
		margin: 0 auto;
		padding: 1.5rem;
		display: flex;
		justify-content: space-between;
		gap: 1rem;
	}
	a {
		color: var(--muted);
	}
	a:hover {
		color: var(--accent);
	}
</style>
