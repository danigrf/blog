---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { kachelVariante, vorschauBild } from '../lib/posts';

interface Props {
	posts: CollectionEntry<'blog'>[];
}
const { posts } = Astro.props;
---

<ul class="post-list">
	{
		posts.map((post, i) => {
			const bild = vorschauBild(post);
			const thema = post.data.tags[0];
			return (
				<li>
					<a href={`/blog/${post.id}/`}>
						<span class="text">
							<span class="meta">
								<FormattedDate date={post.data.pubDate} />
							</span>
							<span class="post-title">{post.data.title}</span>
							<span class="post-desc">{post.data.description}</span>
						</span>
						<span class="thumb" aria-hidden="true">
							{bild ? (
								<Image
									src={bild.src}
									alt=""
									width={184}
									height={123}
									densities={[1, 2]}
									fit="cover"
									position="top"
									format="webp"
									loading={i < 2 ? 'eager' : 'lazy'}
									decoding="async"
								/>
							) : (
								<span class={`kachel kachel-${kachelVariante(post.id)}`}>
									<span class="kachel-jahr">{post.data.pubDate.getFullYear()}</span>
									{thema && <span class="kachel-thema">{thema}</span>}
								</span>
							)}
						</span>
					</a>
				</li>
			);
		})
	}
</ul>
