---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import MehrZumThema from '../components/MehrZumThema.astro';
import { trenneQuellenhinweis } from '../lib/quellenhinweis.mjs';
import { type verwandtePosts, themaSlug } from '../lib/posts';

type Props = CollectionEntry<'blog'>['data'] & { verwandte?: ReturnType<typeof verwandtePosts> };

const { title, description, pubDate, updatedDate, heroImage, vorschau, vorschauAlt, tags, verwandte } = Astro.props;

// Reihenfolge: Text, Box «Auch interessant für dich», Themen, Quellenhinweis (steht im Inhalt, siehe lib/quellenhinweis.mjs).
const [text, quelle] = trenneQuellenhinweis(await Astro.slots.render('default'));
const hatBox = !!verwandte && verwandte.posts.length > 0;
---

<html lang="de-CH">
	<head>
		<BaseHead title={title} description={description} image={vorschau ?? heroImage} imageAlt={vorschauAlt} />
		<style>
			/* Artikel (Design A6): Titel breit, Lesetext schmal (40rem), Archivo. */
			article {
				max-width: 52rem;
			}
			.hero-image img {
				display: block;
				width: 100%;
				max-width: var(--measure);
				height: auto;
				margin: 0 0 2rem;
			}
			.title {
				margin-bottom: 2.5rem;
			}
			.title .meta {
				margin: 0 0 1rem;
			}
			.title h1 {
				margin: 0;
			}
			.updated {
				display: block;
			}
			.prose {
				max-width: var(--measure);
				font-size: 1.125rem;
				line-height: 1.55;
			}
			.prose :global(h2) {
				font-size: 1.75rem;
				line-height: 1.2;
				margin: 1.8em 0 0.5em;
			}
			.prose :global(h3) {
				font-size: 1.375rem;
				margin: 1.6em 0 0.4em;
			}
			.tags {
				max-width: var(--measure);
				margin: 3rem 0 0;
				padding: 1rem 0 0;
				border-top: 2px solid var(--rule);
				font-weight: 500;
				font-size: 0.9375rem;
			}
			.tags .label {
				color: var(--muted);
			}
			.tags a + a::before {
				content: '· ';
				display: inline-block;
				white-space: pre;
				color: var(--muted);
				text-decoration: none;
			}
			.tags a {
				white-space: nowrap;
				display: inline-block;
				padding-block: 6px;
			}
			.tags a + a {
				margin-left: 0.4em;
			}
			.quelle {
				margin-top: 1.5rem;
			}
			.zurueck {
				margin: 0 0 1.5rem;
				font-weight: 500;
				font-size: 0.9375rem;
			}
			.zurueck.unten {
				margin: 2.5rem 0 0;
			}
			@media (max-width: 760px) {
				.prose {
					font-size: 1.0625rem;
				}
				.prose :global(h2) {
					font-size: 1.5rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main id="inhalt">
			<p class="zurueck oben"><a href="/blog/" data-zurueck>← Alle Beiträge</a></p>
			<article>
				{heroImage && <div class="hero-image"><Image width={1020} height={510} src={heroImage} alt="" /></div>}
				<header class="title">
					<p class="meta">
						<FormattedDate date={pubDate} />
						{updatedDate && (
							<span class="updated">
								Zuletzt aktualisiert am <FormattedDate date={updatedDate} />
							</span>
						)}
					</p>
					<h1>{title}</h1>
				</header>
				<div class="prose"><Fragment set:html={text} /></div>
				{hatBox && <MehrZumThema posts={verwandte!.posts} />}
				{tags.length > 0 && (
					<nav class="tags" aria-label="Themen dieses Beitrags">
						<span class="label">Themen: </span>
						{tags.map((t) => (
							<a href={`/themen/${themaSlug(t)}/`}>{t}</a>
						))}
					</nav>
				)}
				{quelle && <div class="prose quelle"><Fragment set:html={quelle} /></div>}
			</article>
			<p class="zurueck unten"><a href="/blog/" data-zurueck>← Alle Beiträge</a></p>
		</main>
		<Footer />
		<script is:inline>
			(function () {
				var links = document.querySelectorAll('a[data-zurueck]');
				if (!links.length) return;
				var ref;
				try { ref = document.referrer ? new URL(document.referrer) : null; } catch (e) { ref = null; }
				if (!ref || ref.origin !== location.origin || ref.pathname === location.pathname) return;
				var pfad = ref.pathname;
				var text = '← Zurück';
				if (/^\/blog\/?$/.test(pfad)) text = '← Zurück zur Übersicht';
				else if (pfad === '/') text = '← Zurück zur Startseite';
				else if (/^\/themen\/?$/.test(pfad)) text = '← Zurück zu den Themen';
				else if (/^\/themen\/[^/]+\/?$/.test(pfad)) {
					var t = document.querySelector('.tags a[href="' + (pfad.slice(-1) === '/' ? pfad : pfad + '/') + '"]');
					text = t ? '← Zurück zu ‹' + t.textContent + '›' : '← Zurück zum Thema';
				}
				Array.prototype.forEach.call(links, function (a) {
					a.textContent = text;
					a.addEventListener('click', function (e) {
						if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button) return;
						if (history.length > 1) { e.preventDefault(); history.back(); }
					});
				});
			})();
		</script>
	</body>
</html>
