---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { themaSlug } from '../lib/posts';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, tags } = Astro.props;
---

<html lang="de-CH">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			.hero-image img {
				display: block;
				width: 100%;
				margin: 0 0 2rem;
			}
			.title {
				margin-bottom: 2.5rem;
				padding-bottom: 1.5rem;
				border-bottom: 1px solid var(--line);
			}
			.title h1 {
				margin: 0.4rem 0 0;
				font-size: 2.3rem;
			}
			.updated {
				display: block;
			}
			.tags {
				margin: 3rem 0 0;
				padding: 1.25rem 0 0;
				border-top: 1px solid var(--line);
				display: flex;
				flex-wrap: wrap;
				align-items: baseline;
				gap: 0.4rem 0.9rem;
				font-family: var(--sans);
				font-size: 0.9rem;
			}
			.tags .label {
				font-family: var(--mono);
				font-size: 0.8rem;
				color: var(--muted);
			}
			.tags a {
				text-decoration: none;
			}
			.tags a:hover {
				text-decoration: underline;
			}
			@media (max-width: 560px) {
				.title h1 {
					font-size: 1.85rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main id="inhalt">
			<article>
				{heroImage && <div class="hero-image"><Image width={1020} height={510} src={heroImage} alt="" /></div>}
				<header class="title">
					<p class="meta">
						<FormattedDate date={pubDate} />
						{updatedDate && (
							<span class="updated">
								Zuletzt aktualisiert am <FormattedDate date={updatedDate} />
							</span>
						)}
					</p>
					<h1>{title}</h1>
				</header>
				<div class="prose">
					<slot />
				</div>
				{tags.length > 0 && (
					<nav class="tags" aria-label="Themen dieses Beitrags">
						<span class="label">Themen</span>
						{tags.map((t) => (
							<a href={`/themen/${themaSlug(t)}/`}>{t}</a>
						))}
					</nav>
				)}
			</article>
		</main>
		<Footer />
	</body>
</html>
