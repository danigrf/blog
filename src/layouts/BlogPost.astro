---
import { Image, getImage } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import MehrZumThema from '../components/MehrZumThema.astro';
import { trenneQuellenhinweis } from '../lib/quellenhinweis.mjs';
import { type verwandtePosts, themaSlug } from '../lib/posts';

type Props = CollectionEntry<'blog'>['data'] & { verwandte?: ReturnType<typeof verwandtePosts> };

const { title, description, pubDate, updatedDate, heroImage, vorschau, vorschauAlt, tags, verwandte } = Astro.props;

// Reihenfolge: Text, Box «Auch interessant für dich», Themen, Quellenhinweis (steht im Inhalt, siehe lib/quellenhinweis.mjs).
const [text, quelle] = trenneQuellenhinweis(await Astro.slots.render('default'));
const hatBox = !!verwandte && verwandte.posts.length > 0;

// Strukturierte Daten (schema.org BlogPosting): Bild wie in der Social-Vorschau (BaseHead).
const bild = vorschau ?? heroImage;
const bildUrl = bild
	? new URL((await getImage({ src: bild, width: 1200, height: 630, fit: 'cover', position: 'top', format: 'jpg' })).src, Astro.site).href
	: undefined;
const start = new URL('/', Astro.site).href;
const autor = { '@type': 'Person', '@id': `${start}#person`, name: 'Daniel Graf', url: start };
const jsonLd = {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	headline: title,
	description,
	url: new URL(Astro.url.pathname, Astro.site).href,
	mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
	datePublished: pubDate.toISOString(),
	...(updatedDate && { dateModified: updatedDate.toISOString() }),
	...(bildUrl && { image: bildUrl }),
	...(tags.length > 0 && { keywords: tags.join(', ') }),
	inLanguage: 'de-CH',
	author: autor,
	publisher: autor,
};
---

<html lang="de-CH">
	<head>
		<BaseHead title={title} description={description} image={vorschau ?? heroImage} imageAlt={vorschauAlt} jsonLd={jsonLd} />
		<style>
			.hero-image img {
				display: block;
				width: 100%;
				margin: 0 0 2rem;
			}
			.title {
				margin-bottom: 2.5rem;
				padding-bottom: 1.5rem;
				border-bottom: 1px solid var(--line);
			}
			.title h1 {
				margin: 0.4rem 0 0;
				font-size: 2.3rem;
			}
			.updated {
				display: block;
			}
			.tags {
				margin: 3rem 0 0;
				padding: 1.25rem 0 0;
				border-top: 1px solid var(--line);
				display: flex;
				flex-wrap: wrap;
				align-items: baseline;
				gap: 0.4rem 0.9rem;
				font-family: var(--sans);
				font-size: 0.9rem;
			}
			.tags .label {
				font-family: var(--mono);
				font-size: 0.8rem;
				color: var(--muted);
			}
			.tags a {
				text-decoration: none;
			}
			.tags a:hover {
				text-decoration: underline;
			}
			.quelle {
				margin-top: 1.5rem;
			}
			.zurueck {
				margin: 0 0 1.25rem;
				font-family: var(--sans);
				font-size: 0.95rem;
			}
			.zurueck.unten {
				margin: 2rem 0 0;
			}
			.zurueck a {
				text-decoration: none;
				color: var(--accent);
			}
			.zurueck a:hover {
				text-decoration: underline;
			}
			@media (max-width: 560px) {
				.title h1 {
					font-size: 1.85rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main id="inhalt">
			<p class="zurueck oben"><a href="/blog/" data-zurueck>← Alle Beiträge</a></p>
			<article>
				{heroImage && <div class="hero-image"><Image width={1020} height={510} src={heroImage} alt="" /></div>}
				<header class="title">
					<p class="meta">
						<FormattedDate date={pubDate} />
						{updatedDate && (
							<span class="updated">
								Zuletzt aktualisiert am <FormattedDate date={updatedDate} />
							</span>
						)}
					</p>
					<h1>{title}</h1>
				</header>
				<div class="prose"><Fragment set:html={text} /></div>
				{hatBox && <MehrZumThema posts={verwandte!.posts} />}
				{tags.length > 0 && (
					<nav class="tags" aria-label="Themen dieses Beitrags">
						<span class="label">Themen</span>
						{tags.map((t) => (
							<a href={`/themen/${themaSlug(t)}/`}>{t}</a>
						))}
					</nav>
				)}
				{quelle && <div class="prose quelle"><Fragment set:html={quelle} /></div>}
			</article>
			<p class="zurueck unten"><a href="/blog/" data-zurueck>← Alle Beiträge</a></p>
		</main>
		<Footer />
		<script is:inline>
			(function () {
				var links = document.querySelectorAll('a[data-zurueck]');
				if (!links.length) return;
				var ref;
				try { ref = document.referrer ? new URL(document.referrer) : null; } catch (e) { ref = null; }
				if (!ref || ref.origin !== location.origin || ref.pathname === location.pathname) return;
				var pfad = ref.pathname;
				var text = '← Zurück';
				if (/^\/blog\/?$/.test(pfad)) text = '← Zurück zur Übersicht';
				else if (pfad === '/') text = '← Zurück zur Startseite';
				else if (/^\/themen\/?$/.test(pfad)) text = '← Zurück zu den Themen';
				else if (/^\/themen\/[^/]+\/?$/.test(pfad)) {
					var t = document.querySelector('.tags a[href="' + (pfad.slice(-1) === '/' ? pfad : pfad + '/') + '"]');
					text = t ? '← Zurück zu ‹' + t.textContent + '›' : '← Zurück zum Thema';
				}
				Array.prototype.forEach.call(links, function (a) {
					a.textContent = text;
					a.addEventListener('click', function (e) {
						if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button) return;
						if (history.length > 1) { e.preventDefault(); history.back(); }
					});
				});
			})();
		</script>
	</body>
</html>
